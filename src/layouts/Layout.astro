---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { t, routes, type Lang } from '../i18n';
import { PROFILE } from '../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang);

// `site` vem de astro.config.mjs; a origem atual é só um plano B.
const site = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, site).href;
const ptUrl = new URL(routes.pt, site).href;
const enUrl = new URL(routes.en, site).href;
---
<!doctype html>
<html lang={d.meta.lang} data-lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{d.meta.title}</title>
    <meta name="description" content={d.meta.description} />
    <meta name="author" content={PROFILE.fullName} />
    <meta name="theme-color" content="#e0262d" />
    <meta name="color-scheme" content="light" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="pt-BR" href={ptUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={ptUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={d.meta.title} />
    <meta property="og:description" content={d.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={d.meta.ogLocale} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={d.meta.title} />
    <meta name="twitter:description" content={d.meta.description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&family=Source+Serif+4:ital,opsz,wght@0,8..60,400..700;1,8..60,400..700&display=swap"
    />

    <!--
      Visitante recorrente: se ele escolheu um idioma antes, abre direto nele.
      Redireciona no máximo uma vez por sessão (a troca manual trava o redirecionamento).
    -->
    <script is:inline define:vars={{ routes }}>
      (function () {
        try {
          var current = document.documentElement.getAttribute('data-lang');
          var preferred = localStorage.getItem('pb:lang');
          var locked = sessionStorage.getItem('pb:lang-lock');
          var known = preferred && Object.prototype.hasOwnProperty.call(routes, preferred);
          var target = known ? routes[preferred] : null;

          if (!locked && target && preferred !== current && location.pathname !== target) {
            location.replace(target);
          }
        } catch (e) {
          /* armazenamento indisponível: segue no idioma atual */
        }
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">{d.a11y.skip}</a>

    <Header lang={lang} />

    <main id="main">
      <slot />
    </main>

    <Footer lang={lang} />

    <script>
      // Guarda o idioma escolhido manualmente para não redirecionar de novo.
      document.querySelectorAll<HTMLAnchorElement>('[data-lang-toggle]').forEach((link) => {
        link.addEventListener('click', () => {
          const target = link.dataset.targetLang;
          if (!target) return;

          try {
            localStorage.setItem('pb:lang', target);
            sessionStorage.setItem('pb:lang-lock', '1');
          } catch (e) {
            /* armazenamento indisponível: a troca de idioma ainda funciona */
          }
        });
      });
    </script>
  </body>
</html>
