---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { t, routes, type Lang } from '../i18n';
import { LINKS, PROFILE } from '../data/site';

interface Props {
  lang: Lang;
  noindex?: boolean;
  title?: string;
  description?: string;
}

const { lang, noindex = false, title, description } = Astro.props;
const d = t(lang);
const pageTitle = title ?? d.meta.title;
const pageDescription = description ?? d.meta.description;

// `site` vem de astro.config.mjs; a origem atual é só um plano B.
const site = Astro.site ?? new URL(Astro.url.origin);
// Páginas `noindex` (404) não recebem canonical: não existe URL indexável.
const canonical = noindex ? null : new URL(Astro.url.pathname, site).href;
const ogUrl = canonical ?? site.href;
const ptUrl = new URL(routes.pt, site).href;
const enUrl = new URL(routes.en, site).href;
const ogImage = new URL('/og/og-image.png', site).href;
const otherLocale = d.meta.ogLocale === 'pt_BR' ? 'en_US' : 'pt_BR';

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: PROFILE.fullName,
  alternateName: PROFILE.shortName,
  url: ogUrl,
  image: ogImage,
  jobTitle: d.meta.jobTitle,
  description: d.meta.description,
  sameAs: [LINKS.github, LINKS.linkedin].filter(Boolean),
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Floriano',
    addressRegion: 'Piauí',
    addressCountry: 'BR',
  },
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'IFPI Campus Floriano',
  },
  knowsAbout: ['C#', '.NET', 'WPF', 'Astro', 'SQL', 'IoT'],
};
---

<!doctype html>
<html lang={d.meta.lang} data-lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="author" content={PROFILE.fullName} />
    <meta name="theme-color" content="#e0262d" />
    <meta name="color-scheme" content="light" />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {canonical && <link rel="canonical" href={canonical} />}
    {!noindex && <link rel="alternate" hreflang="pt-BR" href={ptUrl} />}
    {!noindex && <link rel="alternate" hreflang="en" href={enUrl} />}
    {!noindex && <link rel="alternate" hreflang="x-default" href={ptUrl} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={PROFILE.shortName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:locale" content={d.meta.ogLocale} />
    <meta property="og:locale:alternate" content={otherLocale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${PROFILE.shortName} — ${d.meta.jobTitle}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={`${PROFILE.shortName} — ${d.meta.jobTitle}`} />

    <link rel="preload" href="/fonts/archivo-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link
      rel="preload"
      href="/fonts/source-serif-4-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
    <!--
      Visitante recorrente: se ele escolheu um idioma antes, abre direto nele.
      O redirecionamento só acontece na raiz; um acesso explícito a /en/ é sempre respeitado.
    -->
    <script is:inline define:vars={{ routes }}>
      (function () {
        try {
          const current = document.documentElement.getAttribute('data-lang');
          const preferred = localStorage.getItem('pb:lang');
          const locked = sessionStorage.getItem('pb:lang-lock');
          const known = preferred && Object.prototype.hasOwnProperty.call(routes, preferred);
          const target = known ? routes[preferred] : null;
          const root = routes.pt;
          const isRoot = location.pathname === root || location.pathname === root + 'index.html';

          if (!locked && isRoot && target && preferred !== current) {
            location.replace(target);
          }
        } catch {
          /* armazenamento indisponível: segue no idioma atual */
        }
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">
      {d.a11y.skip}
    </a>

    <Header lang={lang} />

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <Footer lang={lang} />

    <script>
      // Guarda o idioma escolhido manualmente para não redirecionar de novo.
      document.querySelectorAll<HTMLAnchorElement>('[data-lang-toggle]').forEach((link) => {
        link.addEventListener('click', () => {
          const target = link.dataset.targetLang;
          if (!target) return;

          try {
            localStorage.setItem('pb:lang', target);
            sessionStorage.setItem('pb:lang-lock', '1');
          } catch {
            /* armazenamento indisponível: a troca de idioma ainda funciona */
          }
        });
      });
    </script>
  </body>
</html>
