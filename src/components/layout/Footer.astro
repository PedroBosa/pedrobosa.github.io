---
import { t, type Lang } from '../../i18n';
import { PROFILE } from '../../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang);
---
<footer class="foot">
  <div class="wrap">
    <p>© {new Date().getFullYear()} {PROFILE.fullName}</p>
    <p>{d.footer.builtWith}</p>
    <a class="ulink" href="#home">{d.footer.top}</a>
  </div>
</footer>
