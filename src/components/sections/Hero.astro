---
import Edge from '../ui/Edge.astro';
import { t, type Lang } from '../../i18n';
import { LINKS, PROFILE } from '../../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang);
const [firstName, lastName] = PROFILE.shortName.split(' ');
---
<section class="hero on-red" id="home">
  <canvas class="paint" aria-hidden="true"></canvas>

  <div class="wrap hero-main">
    <h1><span>{firstName}</span>{' '}<span>{lastName}</span></h1>

    <div class="hero-side">
      <p class="eyebrow">{d.hero.eyebrow}</p>
      <p class="status">{d.hero.role} · {d.hero.status}</p>
      <p class="lead">{d.hero.lead}</p>
      <p class="acts">
        <a class="btn" href="#projects">{d.hero.ctaProjects}</a>
        <a class="btn btn--ghost" href={LINKS.cv[lang]} download>{d.hero.ctaCv}</a>
        <a class="ulink" href={`mailto:${LINKS.email}`}>{d.hero.ctaEmail}</a>
        <a class="ulink" href={LINKS.github} target="_blank" rel="noopener noreferrer">{d.hero.ctaGithub}</a>
        {LINKS.linkedin && (
          <a class="ulink" href={LINKS.linkedin} target="_blank" rel="noopener noreferrer">{d.contact.linkedinLabel}</a>
        )}
      </p>
    </div>
  </div>

  <Edge tone="bg" pos="bottom" />
</section>

<script>
  /**
   * Tinta do hero.
   *
   * Segure o botão e arraste para desenhar. Cada pincelada **fica** na tela
   * até a página ser recarregada — nada desaparece.
   *
   * O traço não tem textura: o que faz parecer pincel é a forma. A largura
   * acompanha a mão (devagar engrossa, rápido afina), a entrada é arredondada
   * e, ao soltar, a ponta afina como um pincel saindo do papel. Uma cor só,
   * vinda do token `--ink`.
   *
   * Como funciona:
   * - os traços são guardados em coordenadas normalizadas (0 a 1), então
   *   sobrevivem ao redimensionamento da janela;
   * - a tinta "seca" fica numa camada própria; a cada quadro só o traço em
   *   andamento é redesenhado por cima, como um polígono único.
   *
   * Sem dependências e sem animação própria: só desenha quando a pessoa desenha.
   */
  const hero = document.getElementById('home');
  const canvas = hero?.querySelector<HTMLCanvasElement>('canvas.paint');

  if (hero && canvas) {
    const ctx = canvas.getContext('2d');
    const settled = document.createElement('canvas');
    const settledCtx = settled.getContext('2d');

    if (ctx && settledCtx) {
      /** Ponto normalizado: `x`/`y` de 0 a 1 e `w` como fração do menor lado. */
      type Point = { x: number; y: number; w: number };
      type Pixel = { x: number; y: number; w: number };

      const MIN_STEP = 1;
      const MAX_POINTS = 700;
      const MAX_STROKES = 80;

      // Largura do pincel, proporcional à tela.
      const BASE_RATIO = 0.034;
      const BASE_MIN = 14;
      const BASE_MAX = 34;

      const clamp = (value: number, min: number, max: number) =>
        Math.min(max, Math.max(min, value));

      const ink = getComputedStyle(hero).getPropertyValue('--ink').trim() || '#0e1b3d';

      let width = 0;
      let height = 0;
      let dpr = 1;

      /** Traços concluídos, em coordenadas normalizadas. */
      const strokes: Point[][] = [];
      /** Traço em andamento (ainda no pincel). */
      let live: Point[] | null = null;

      let lastAt = 0;
      let speed = 0;
      let scheduled = false;

      const baseWidthAt = (minDim: number) =>
        clamp(minDim * BASE_RATIO, BASE_MIN, BASE_MAX);

      /**
       * Normalizado → pixels, com um leve alisamento do tremor do mouse.
       * A largura é a mesma do começo ao fim: o traço entra cheio e redondo,
       * como um pincel encostando no papel.
       */
      const toPixels = (points: Point[]): Pixel[] => {
        const count = points.length;
        const minDim = Math.min(width, height);
        const out: Pixel[] = [];

        for (let i = 0; i < count; i++) {
          const point = points[i];
          let x = point.x * width;
          let y = point.y * height;

          if (i > 0 && i < count - 1) {
            const before = points[i - 1];
            const after = points[i + 1];
            x = (before.x + point.x * 2 + after.x) * 0.25 * width;
            y = (before.y + point.y * 2 + after.y) * 0.25 * height;
          }

          out.push({ x, y, w: point.w * minDim });
        }

        return out;
      };

      /**
       * Desenha o rastro como uma sequência de segmentos de ponta redonda.
       *
       * A alternativa — um polígono único com as bordas deslocadas — falha
       * justamente onde a mão muda de direção: as duas bordas se cruzam e
       * aparece um entalhe no lado de fora da curva. Com ponta redonda, cada
       * emenda já é um arco e nenhum canto consegue quebrar o traço.
       */
      const paint = (target: CanvasRenderingContext2D, points: Point[]) => {
        if (points.length < 2) return;

        const px = toPixels(points);
        target.strokeStyle = ink;
        target.lineCap = 'round';
        target.lineJoin = 'round';

        for (let i = 1; i < px.length; i++) {
          const from = px[i - 1];
          const to = px[i];
          target.lineWidth = Math.max(0.5, (from.w + to.w) / 2);
          target.beginPath();
          target.moveTo(from.x, from.y);
          target.lineTo(to.x, to.y);
          target.stroke();
        }
      };

      const render = () => {
        ctx.clearRect(0, 0, width, height);
        ctx.drawImage(settled, 0, 0, width, height);
        if (live) paint(ctx, live);
      };

      // Um desenho por quadro, mesmo com vários eventos de ponteiro.
      const schedule = () => {
        if (scheduled) return;
        scheduled = true;
        requestAnimationFrame(() => {
          scheduled = false;
          render();
        });
      };

      // ---------- Redimensionamento ----------

      const resize = () => {
        const rect = hero.getBoundingClientRect();
        const nextWidth = Math.max(1, rect.width);
        const nextHeight = Math.max(1, rect.height);
        const nextDpr = Math.min(
          devicePixelRatio || 1,
          nextWidth * nextHeight > 1_000_000 ? 1.5 : 2,
        );

        if (nextWidth === width && nextHeight === height && nextDpr === dpr) return;

        width = nextWidth;
        height = nextHeight;
        dpr = nextDpr;

        canvas.width = Math.round(width * dpr);
        canvas.height = Math.round(height * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

        settled.width = canvas.width;
        settled.height = canvas.height;
        settledCtx.setTransform(dpr, 0, 0, dpr, 0, 0);

        // A tinta já seca é repintada no tamanho novo: o desenho sobrevive.
        settledCtx.clearRect(0, 0, width, height);
        for (const stroke of strokes) paint(settledCtx, stroke);

        render();
      };

      // ---------- Entrada do ponteiro ----------

      const pointAt = (event: PointerEvent) => {
        const rect = hero.getBoundingClientRect();
        return {
          x: clamp((event.clientX - rect.left) / rect.width, 0, 1),
          y: clamp((event.clientY - rect.top) / rect.height, 0, 1),
        };
      };

      const onPointerDown = (event: PointerEvent) => {
        // Toque rola a página; só mouse e caneta desenham.
        if (event.button !== 0 || event.pointerType === 'touch') return;

        // Não atrapalha link, botão nem campo: neles o clique continua clique.
        const target = event.target as Element | null;
        if (target?.closest('a, button, input, textarea, select, label')) return;

        event.preventDefault();

        const point = pointAt(event);
        const minDim = Math.min(width, height);
        live = [{ x: point.x, y: point.y, w: baseWidthAt(minDim) / minDim }];
        speed = 0;
        lastAt = performance.now();
        hero.classList.add('is-inking');
        schedule();
      };

      const onPointerMove = (event: PointerEvent) => {
        if (!live) return;

        const point = pointAt(event);
        const last = live[live.length - 1];
        const minDim = Math.min(width, height);
        const distance = Math.hypot(
          (point.x - last.x) * width,
          (point.y - last.y) * height,
        );

        if (distance < MIN_STEP) return;

        const now = performance.now();
        const elapsed = Math.max(1, now - lastAt);
        speed = speed * 0.6 + (distance / elapsed) * 0.4;
        lastAt = now;

        // Devagar engrossa, rápido afina — mas de leve, para o traço não
        // mudar de espessura de um jeito que não corresponde à mão.
        const speedT = clamp((speed - 0.15) / 2.2, 0, 1);
        const wanted = (baseWidthAt(minDim) * (1 - 0.28 * speedT)) / minDim;
        const next = last.w + (wanted - last.w) * 0.35;

        live.push({ x: point.x, y: point.y, w: next });
        if (live.length > MAX_POINTS) live.shift();

        schedule();
      };

      const finish = () => {
        if (!live) return;

        const points = live;
        live = null;
        speed = 0;
        hero.classList.remove('is-inking');

        // Ao soltar, a ponta fecha logo. Antes ela esticava um rabicho de
        // ~40px além de onde a mão parou, o que não correspondia ao gesto.
        if (points.length >= 2) {
          const minDim = Math.min(width, height);
          const base = baseWidthAt(minDim);
          const head = points[points.length - 1];
          const tail = points[points.length - 2];

          let dx = (head.x - tail.x) * width;
          let dy = (head.y - tail.y) * height;
          const length = Math.hypot(dx, dy) || 1;
          dx /= length;
          dy /= length;

          const reach = base * 0.4;
          for (let step = 1; step <= 2; step++) {
            const t = step / 2;
            const fade = (1 - t) * (1 - t);
            points.push({
              x: head.x + (dx * reach * t) / width,
              y: head.y + (dy * reach * t) / height,
              w: head.w * fade,
            });
          }

          paint(settledCtx, points);
          if (strokes.length >= MAX_STROKES) strokes.shift();
          strokes.push(points);
        }

        render();
      };

      hero.addEventListener('pointerdown', onPointerDown);
      hero.addEventListener('pointermove', onPointerMove);
      hero.addEventListener('pointerleave', finish);
      window.addEventListener('pointerup', finish);
      window.addEventListener('pointercancel', finish);

      // Duplo clique limpa a tela: o hero volta a ser só tipografia.
      hero.addEventListener('dblclick', () => {
        strokes.length = 0;
        settledCtx.clearRect(0, 0, width, height);
        render();
      });

      window.addEventListener('resize', resize);
      if ('ResizeObserver' in window) {
        new ResizeObserver(resize).observe(hero);
      }

      resize();
    }
  }
</script>
