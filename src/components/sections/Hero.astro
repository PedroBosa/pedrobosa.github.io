---
import Edge from '../ui/Edge.astro';
import { t, type Lang } from '../../i18n';
import { LINKS, PROFILE } from '../../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang);
const [firstName, lastName] = PROFILE.shortName.split(' ');
---
<section class="hero on-red" id="home">
  <canvas class="paint" aria-hidden="true"></canvas>

  <div class="wrap hero-main">
    <h1><span>{firstName}</span>{' '}<span>{lastName}</span></h1>

    <div class="hero-side">
      <p class="eyebrow">{d.hero.eyebrow}</p>
      <p class="status">{d.hero.role} · {d.hero.status}</p>
      <p class="lead">{d.hero.lead}</p>
      <p class="acts">
        <a class="btn" href="#projects">{d.hero.ctaProjects}</a>
        <a class="btn btn--ghost" href={LINKS.cv[lang]} download>{d.hero.ctaCv}</a>
        <a class="ulink" href={`mailto:${LINKS.email}`}>{d.hero.ctaEmail}</a>
        <a class="ulink" href={LINKS.github} target="_blank" rel="noopener noreferrer">{d.hero.ctaGithub}</a>
        {LINKS.linkedin && (
          <a class="ulink" href={LINKS.linkedin} target="_blank" rel="noopener noreferrer">{d.contact.linkedinLabel}</a>
        )}
      </p>
    </div>
  </div>

  <Edge tone="bg" pos="bottom" />
</section>

<script>
  /**
   * Tinta do hero.
   *
   * Segure o botão e arraste para desenhar. Cada pincelada **fica** na tela
   * até a página ser recarregada — nada desaparece.
   *
   * O traço não tem textura: o que faz parecer pincel é a forma. A largura
   * acompanha a mão (devagar engrossa, rápido afina), a entrada é arredondada
   * e, ao soltar, a ponta afina como um pincel saindo do papel. Uma cor só,
   * vinda do token `--ink`.
   *
   * Como funciona:
   * - os traços são guardados em coordenadas normalizadas (0 a 1), então
   *   sobrevivem ao redimensionamento da janela;
   * - a tinta "seca" fica numa camada própria; a cada quadro só o traço em
   *   andamento é redesenhado por cima, como um polígono único.
   *
   * Sem dependências e sem animação própria: só desenha quando a pessoa desenha.
   */
  const hero = document.getElementById('home');
  const canvas = hero?.querySelector<HTMLCanvasElement>('canvas.paint');

  if (hero && canvas) {
    const ctx = canvas.getContext('2d');
    const settled = document.createElement('canvas');
    const settledCtx = settled.getContext('2d');

    if (ctx && settledCtx) {
      /** Ponto normalizado: `x`/`y` de 0 a 1 e `w` como fração do menor lado. */
      type Point = { x: number; y: number; w: number };
      type Pixel = { x: number; y: number; w: number };

      const MIN_STEP = 1;
      const MAX_POINTS = 700;
      const MAX_STROKES = 80;
      const CAP_STEPS = 14;

      // Largura do pincel, proporcional à tela.
      const BASE_RATIO = 0.034;
      const BASE_MIN = 14;
      const BASE_MAX = 34;

      const clamp = (value: number, min: number, max: number) =>
        Math.min(max, Math.max(min, value));

      const smoothstep = (edge0: number, edge1: number, x: number) => {
        const t = clamp((x - edge0) / (edge1 - edge0), 0, 1);
        return t * t * (3 - 2 * t);
      };

      const ink = getComputedStyle(hero).getPropertyValue('--ink').trim() || '#0e1b3d';

      let width = 0;
      let height = 0;
      let dpr = 1;

      /** Traços concluídos, em coordenadas normalizadas. */
      const strokes: Point[][] = [];
      /** Traço em andamento (ainda no pincel). */
      let live: Point[] | null = null;

      let lastAt = 0;
      let speed = 0;
      let scheduled = false;

      /**
       * Dica de descoberta: um traço-fantasma que se desenha sozinho logo depois
       * que a página assenta. Sem texto — não precisa de tradução — e sai de
       * cena no primeiro traço de verdade. `hintReveal` vai de 0 a 1.
       */
      let hintReveal = 0;
      let hintAlive = true;

      const baseWidthAt = (minDim: number) =>
        clamp(minDim * BASE_RATIO, BASE_MIN, BASE_MAX);

      /** Normalizado → pixels, com um leve alisamento do tremor do mouse. */
      const toPixels = (points: Point[]): Pixel[] => {
        const count = points.length;
        const minDim = Math.min(width, height);
        const base = baseWidthAt(minDim);
        const out: Pixel[] = [];

        let travelled = 0;
        let previousX = 0;
        let previousY = 0;

        for (let i = 0; i < count; i++) {
          const point = points[i];
          let x = point.x * width;
          let y = point.y * height;

          if (i > 0 && i < count - 1) {
            const before = points[i - 1];
            const after = points[i + 1];
            x = (before.x + point.x * 2 + after.x) * 0.25 * width;
            y = (before.y + point.y * 2 + after.y) * 0.25 * height;
          }

          if (i > 0) travelled += Math.hypot(x - previousX, y - previousY);
          previousX = x;
          previousY = y;

          // Entrada curta: a tinta encosta no papel e abre em leque.
          out.push({ x, y, w: point.w * minDim * smoothstep(0, base, travelled) });
        }

        return out;
      };

      /**
       * Um polígono só: borda esquerda na ida, arco na frente, borda direita na
       * volta e arco atrás. Fechado assim, não existe emenda entre segmentos.
       */
      const tracePath = (target: CanvasRenderingContext2D, px: Pixel[], lift: boolean) => {
        const count = px.length;
        if (count < 2) return false;

        const nx: number[] = [];
        const ny: number[] = [];

        for (let i = 0; i < count; i++) {
          const before = px[Math.max(0, i - 1)];
          const after = px[Math.min(count - 1, i + 1)];
          const tx = after.x - before.x;
          const ty = after.y - before.y;
          const length = Math.hypot(tx, ty) || 1;
          nx.push(-ty / length);
          ny.push(tx / length);
        }

        const angleAt = (i: number) => {
          const before = px[Math.max(0, i - 1)];
          const after = px[Math.min(count - 1, i + 1)];
          return Math.atan2(after.y - before.y, after.x - before.x);
        };

        const half = (i: number) => Math.max(0, px[i].w / 2);

        target.beginPath();

        for (let i = 0; i < count; i++) {
          const h = half(i);
          const x = px[i].x + nx[i] * h;
          const y = px[i].y + ny[i] * h;
          if (i === 0) target.moveTo(x, y);
          else target.lineTo(x, y);
        }

        // Frente: redonda enquanto o pincel está no papel. Depois de solto, a
        // cauda já afina sozinha e dispensa o arco.
        if (!lift) {
          const head = count - 1;
          const r = half(head);
          const angle = angleAt(head);
          for (let k = 1; k <= CAP_STEPS; k++) {
            const theta = angle + Math.PI / 2 - (Math.PI * k) / CAP_STEPS;
            target.lineTo(px[head].x + Math.cos(theta) * r, px[head].y + Math.sin(theta) * r);
          }
        }

        for (let i = count - 1; i >= 0; i--) {
          const h = half(i);
          target.lineTo(px[i].x - nx[i] * h, px[i].y - ny[i] * h);
        }

        // Trás: sempre redonda, é onde o pincel encostou.
        {
          const r = half(0);
          const angle = angleAt(0);
          for (let k = 1; k <= CAP_STEPS; k++) {
            const theta = angle - Math.PI / 2 - (Math.PI * k) / CAP_STEPS;
            target.lineTo(px[0].x + Math.cos(theta) * r, px[0].y + Math.sin(theta) * r);
          }
        }

        target.closePath();
        return true;
      };

      const paint = (
        target: CanvasRenderingContext2D,
        points: Point[],
        lift: boolean,
      ) => {
        if (points.length < 2) return;
        target.fillStyle = ink;
        if (tracePath(target, toPixels(points), lift)) target.fill();
      };

      // ---------- Dica de descoberta ----------

      const HINT_ALPHA = 0.3;

      /** Curva da dica, em coordenadas normalizadas: canto vazio inferior do hero. */
      const HINT_PATH: Point[] = (() => {
        const control = [
          { x: 0.04, y: 0.885 },
          { x: 0.115, y: 0.835 },
          { x: 0.2, y: 0.895 },
          { x: 0.29, y: 0.845 },
        ];
        const steps = 46;
        const points: Point[] = [];

        for (let i = 0; i < steps; i++) {
          const t = i / (steps - 1);
          const e = t * t * (3 - 2 * t);
          const u = 1 - e;
          const [a, b, c, d] = control;
          points.push({
            x: u * u * u * a.x + 3 * u * u * e * b.x + 3 * u * e * e * c.x + e * e * e * d.x,
            y: u * u * u * a.y + 3 * u * u * e * b.y + 3 * u * e * e * c.y + e * e * e * d.y,
            // bem mais fino que o pincel de verdade: lê como convite, não como tinta.
            w: BASE_RATIO * 0.5 * Math.pow(Math.sin(Math.PI * t), 0.7),
          });
        }

        return points;
      })();

      const animateHint = () => {
        if (!hintAlive) return;

        // Com movimento reduzido a dica aparece pronta, sem se desenhar.
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
          hintReveal = 1;
          render();
          return;
        }

        const startedAt = performance.now();
        const step = (now: number) => {
          if (!hintAlive) return;
          hintReveal = clamp((now - startedAt) / 900, 0, 1);
          render();
          if (hintReveal < 1) requestAnimationFrame(step);
        };

        requestAnimationFrame(step);
      };

      /** Sai de cena no primeiro traço de verdade. */
      const dismissHint = () => {
        if (!hintAlive) return;
        hintAlive = false;
        hintReveal = 0;
      };

      const render = () => {
        ctx.clearRect(0, 0, width, height);
        ctx.drawImage(settled, 0, 0, width, height);

        if (hintReveal > 0) {
          const shown = Math.max(2, Math.round(HINT_PATH.length * hintReveal));
          ctx.globalAlpha = HINT_ALPHA;
          paint(ctx, HINT_PATH.slice(0, shown), false);
          ctx.globalAlpha = 1;
        }

        if (live) paint(ctx, live, false);
      };

      // Um desenho por quadro, mesmo com vários eventos de ponteiro.
      const schedule = () => {
        if (scheduled) return;
        scheduled = true;
        requestAnimationFrame(() => {
          scheduled = false;
          render();
        });
      };

      // ---------- Redimensionamento ----------

      const resize = () => {
        const rect = hero.getBoundingClientRect();
        const nextWidth = Math.max(1, rect.width);
        const nextHeight = Math.max(1, rect.height);
        const nextDpr = Math.min(
          devicePixelRatio || 1,
          nextWidth * nextHeight > 1_000_000 ? 1.5 : 2,
        );

        if (nextWidth === width && nextHeight === height && nextDpr === dpr) return;

        width = nextWidth;
        height = nextHeight;
        dpr = nextDpr;

        canvas.width = Math.round(width * dpr);
        canvas.height = Math.round(height * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

        settled.width = canvas.width;
        settled.height = canvas.height;
        settledCtx.setTransform(dpr, 0, 0, dpr, 0, 0);

        // A tinta já seca é repintada no tamanho novo: o desenho sobrevive.
        settledCtx.clearRect(0, 0, width, height);
        for (const stroke of strokes) paint(settledCtx, stroke, true);

        render();
      };

      // ---------- Entrada do ponteiro ----------

      const pointAt = (event: PointerEvent) => {
        const rect = hero.getBoundingClientRect();
        return {
          x: clamp((event.clientX - rect.left) / rect.width, 0, 1),
          y: clamp((event.clientY - rect.top) / rect.height, 0, 1),
        };
      };

      const onPointerDown = (event: PointerEvent) => {
        // Toque rola a página; só mouse e caneta desenham.
        if (event.button !== 0 || event.pointerType === 'touch') return;

        // Não atrapalha link, botão nem campo: neles o clique continua clique.
        const target = event.target as Element | null;
        if (target?.closest('a, button, input, textarea, select, label')) return;

        event.preventDefault();
        dismissHint();

        const point = pointAt(event);
        const minDim = Math.min(width, height);
        live = [{ x: point.x, y: point.y, w: baseWidthAt(minDim) / minDim }];
        speed = 0;
        lastAt = performance.now();
        hero.classList.add('is-inking');
        schedule();
      };

      // A dica só entra quando a pessoa mexe o mouse aqui dentro. Aparecer
      // sozinha no carregamento virava um risco sem explicação no hero.
      let hintScheduled = false;
      const inviteToDraw = () => {
        if (!hintAlive || hintScheduled) return;
        hintScheduled = true;
        setTimeout(animateHint, 300);
      };

      const onPointerMove = (event: PointerEvent) => {
        inviteToDraw();

        if (!live) return;

        const point = pointAt(event);
        const last = live[live.length - 1];
        const minDim = Math.min(width, height);
        const distance = Math.hypot(
          (point.x - last.x) * width,
          (point.y - last.y) * height,
        );

        if (distance < MIN_STEP) return;

        const now = performance.now();
        const elapsed = Math.max(1, now - lastAt);
        speed = speed * 0.6 + (distance / elapsed) * 0.4;
        lastAt = now;

        // Devagar engrossa, rápido afina — a pressão que a mão não tem.
        const speedT = clamp((speed - 0.15) / 2.2, 0, 1);
        const wanted = (baseWidthAt(minDim) * (1 - 0.45 * speedT)) / minDim;
        const next = last.w + (wanted - last.w) * 0.35;

        live.push({ x: point.x, y: point.y, w: next });
        if (live.length > MAX_POINTS) live.shift();

        schedule();
      };

      const finish = () => {
        if (!live) return;

        const points = live;
        live = null;
        speed = 0;
        hero.classList.remove('is-inking');

        // Ao soltar, a ponta afina: o pincel saindo do papel.
        if (points.length >= 2) {
          const minDim = Math.min(width, height);
          const base = baseWidthAt(minDim);
          const head = points[points.length - 1];
          const tail = points[points.length - 2];

          let dx = (head.x - tail.x) * width;
          let dy = (head.y - tail.y) * height;
          const length = Math.hypot(dx, dy) || 1;
          dx /= length;
          dy /= length;

          const reach = base * 1.4;
          for (let step = 1; step <= 3; step++) {
            const t = step / 3;
            const fade = (1 - t) * (1 - t);
            points.push({
              x: head.x + (dx * reach * t) / width,
              y: head.y + (dy * reach * t) / height,
              w: head.w * fade,
            });
          }

          paint(settledCtx, points, true);
          if (strokes.length >= MAX_STROKES) strokes.shift();
          strokes.push(points);
        }

        render();
      };

      hero.addEventListener('pointerdown', onPointerDown);
      hero.addEventListener('pointermove', onPointerMove);
      hero.addEventListener('pointerleave', finish);
      window.addEventListener('pointerup', finish);
      window.addEventListener('pointercancel', finish);

      // Duplo clique limpa a tela: o hero volta a ser só tipografia.
      hero.addEventListener('dblclick', () => {
        strokes.length = 0;
        hintAlive = false;
        hintReveal = 0;
        settledCtx.clearRect(0, 0, width, height);
        render();
      });

      window.addEventListener('resize', resize);
      if ('ResizeObserver' in window) {
        new ResizeObserver(resize).observe(hero);
      }

      resize();
    }
  }
</script>
