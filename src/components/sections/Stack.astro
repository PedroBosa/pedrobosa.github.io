---
import Edge from '../ui/Edge.astro';
import { t, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang);
---

<section class="sec" id="stack">
  <Edge tone="bg" />

  <div class="wrap">
    <h2>{d.nav.stack}</h2>
    <p class="sec-intro">{d.stack.lead}</p>

    <dl class="stack">
      {d.stack.groups.map((group) => (
        <div>
          <dt>{group.title}</dt>
          <dd>
            <ul class="words">
              {group.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </dd>
        </div>
      ))}
    </dl>

    <p class="note">{d.stack.note}</p>
  </div>
</section>
