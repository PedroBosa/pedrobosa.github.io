---
import Mesh from '../ui/Mesh.astro';
import { t, type Lang } from '../../i18n';
import { FALLBACK_STATS, type RepoStats } from '../../data/site';

interface Props {
  lang: Lang;
  repoStats?: RepoStats;
}

const { lang, repoStats = FALLBACK_STATS } = Astro.props;
const d = t(lang);
const p2 = d.about.p2
  .replace(`${FALLBACK_STATS.stars} `, `${repoStats.stars} `)
  .replace(`${FALLBACK_STATS.forks} `, `${repoStats.forks} `);
---

<section class="sec" id="about">
  <Mesh />

  <div class="wrap">
    <h2>{d.nav.about}</h2>

    <div class="about">
      <p class="statement">{d.about.p1}</p>
      <p class="prose">{p2}</p>
    </div>

    <dl class="trio">
      {d.about.facts.map((fact) => (
        <div>
          <dt>{fact.label}</dt>
          <dd>{fact.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
