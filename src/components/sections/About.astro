---
import Staff from '../ui/Staff.astro';
import { t, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang);
---
<section class="sec" id="about">
  <Staff />

  <div class="wrap">
    <h2>{d.nav.about}</h2>

    <div class="about">
      <p class="statement">{d.about.p1}</p>
      <p class="prose">{d.about.p2}</p>
    </div>

    <dl class="trio">
      {d.about.facts.map((fact) => (
        <div>
          <dt>{fact.label}</dt>
          <dd>{fact.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
