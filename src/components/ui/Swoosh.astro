---
/** Traço decorativo ao fundo de uma seção. `variant` escolhe a posição e a cor (styles/components.css). */
interface Props {
  variant: 'a' | 'b';
}

const { variant } = Astro.props;
---
<svg class={`swoosh swoosh--${variant}`} viewBox="-40 -50 680 380" aria-hidden="true">
  <path d="M10 220C120 40 260 280 360 120S540 60 590 140" />
</svg>
