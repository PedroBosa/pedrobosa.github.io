---
/**
 * Detalhe de fundo com tema musical: um disco de vinil.
 *
 * O disco é um círculo preenchido bem claro; os sulcos são anéis na cor do
 * fundo, "escavados" nele — é isso que faz a forma ler como vinil em vez de
 * um círculo solto. O selo traz o vermelho da marca e o furo vaza a seção.
 *
 * Posição, escala e opacidades ficam no CSS (ver .vinyl em components.css),
 * junto dos outros detalhes de fundo.
 */
---
<svg class="vinyl" viewBox="0 0 200 200" aria-hidden="true" focusable="false">
  <circle class="vinyl-disc" cx="100" cy="100" r="99" />
  <g class="vinyl-grooves">
    <circle cx="100" cy="100" r="94" />
    <circle cx="100" cy="100" r="88" />
    <circle cx="100" cy="100" r="82" />
    <circle cx="100" cy="100" r="76" />
    <circle cx="100" cy="100" r="70" />
    <circle cx="100" cy="100" r="64" />
    <circle cx="100" cy="100" r="58" />
    <circle cx="100" cy="100" r="52" />
    <circle cx="100" cy="100" r="46" />
  </g>
  <circle class="vinyl-label" cx="100" cy="100" r="30" />
  <circle class="vinyl-hole" cx="100" cy="100" r="3.2" />
</svg>
