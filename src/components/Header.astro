---
import { t, routes, altLang, type Lang } from '../i18n/ui';
import { sections } from '../data/sections';
import { LINKS } from '../data/site';
const { lang } = Astro.props as { lang: Lang };
const d = t(lang);
const other = altLang(lang);
const navItems = sections.filter((s) => s.id !== 'home');
---
<header class="hdr" id="site-header">
  <div class="hdr-in">
    <a class="brand" href="#home">Pedro Bosa</a>
    <nav class="hdr-nav" aria-label={d.a11y.mainNav}>
      {navItems.map((i) => <a href={`#${i.id}`}>{d.nav[i.id]}</a>)}
    </nav>
    <div class="hdr-act">
      <a class="sbtn" href="#projects">{d.header.preview}</a>
      <a class="sbtn" href={LINKS.repo} target="_blank" rel="noopener noreferrer">{d.header.github}</a>
      <a class="sbtn sbtn--fill" href={LINKS.release} target="_blank" rel="noopener noreferrer">{d.header.download}</a>
    </div>
    <a class="lang" href={routes[other]} data-lang-toggle data-target-lang={other} hreflang={other} title={`${d.header.language}: ${d.header.other}`}>
      {d.header.otherShort}<span class="sr-only"> {d.header.language}: {d.header.other}</span>
    </a>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  if (header) {
    const apply = () => header.classList.toggle('is-scrolled', window.scrollY > 50);
    window.addEventListener('scroll', apply, { passive: true });
    window.addEventListener('pageshow', apply);
    apply();
  }
</script>
