---
import { t, type Lang } from '../i18n/ui';
import { sections } from '../data/sections';
import {
  UNITS,
  C,
  R_IN,
  R_OUT,
  sectorPath,
  anchorPoint,
  shiftVector,
} from '../lib/radial';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang);

const COUNT = sections.length;

const items = sections.map((section, index) => {
  const anchor = anchorPoint(index, COUNT);
  const { tx, ty } = shiftVector(index, COUNT);

  return {
    id: section.id,
    index,
    icon: section.icon,
    label: d.nav[section.id],
    path: sectorPath(index, COUNT),
    iconX: anchor.x,
    iconY: anchor.y,
    tx,
    ty,
  };
});
---

<div
  class="radial"
  id="radial-menu"
  role="dialog"
  aria-label={d.a11y.radial}
  aria-hidden="true"
  hidden
>
  <div class="radial-scrim" data-radial-close></div>

  <button class="radial-close" type="button" data-radial-close aria-label={d.a11y.close}>
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
      <path d="M6.4 6.4 17.6 17.6" />
      <path d="M17.6 6.4 6.4 17.6" />
    </svg>
  </button>

  <div class="radial-wheel">
    <svg class="radial-svg" viewBox={`0 0 ${UNITS} ${UNITS}`} aria-hidden="true">

      {items.map((item) => (
        <g
          class="sector"
          data-index={item.index}
          data-target={`#${item.id}`}
          data-label={item.label}
          style={`--i:${item.index};--tx:${item.tx}px;--ty:${item.ty}px`}
        >
          <g class="sector-shift">
            <path class="sector-fill" d={item.path} />
            <g
              class="sector-icon"
              transform={`translate(${item.iconX} ${item.iconY}) scale(${20 / 24}) translate(-12 -12)`}
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
              set:html={item.icon}
            />
          </g>
        </g>
      ))}
    </svg>

    <div class="radial-hub">
      <span class="radial-hub-dot" aria-hidden="true"></span>
      <span class="radial-hub-label" data-radial-label aria-live="polite"></span>
    </div>
  </div>

  <p class="radial-legend">{d.a11y.radialKeys}</p>
</div>

<style>
  .radial{position:fixed;inset:0;z-index:200}
  .radial[hidden]{display:none}
  .radial-scrim{position:absolute;inset:0;background:rgba(23,24,28,.78);opacity:0;transition:opacity .2s}
  .radial.is-open .radial-scrim{opacity:1}
  .radial-wheel{position:absolute;left:var(--rx,50%);top:var(--ry,50%);width:clamp(280px,46vmin,380px);aspect-ratio:1;transform:translate(-50%,-50%) scale(.92);opacity:0;transition:transform .25s cubic-bezier(.2,.9,.3,1.15),opacity .2s}
  .radial.is-open .radial-wheel{transform:translate(-50%,-50%);opacity:1}
  .radial-svg{width:100%;height:100%;overflow:visible}
  .sector-shift{transition:transform .15s}
  .sector.is-active .sector-shift{transform:translate(var(--tx),var(--ty))}
  .sector-fill{fill:var(--paper);stroke:var(--ink);stroke-width:2;transition:fill .12s}
  .sector.is-active .sector-fill{fill:var(--blue)}
  .sector-icon{color:var(--ink)}
  .sector.is-active .sector-icon{color:#fff}
  .radial-hub{position:absolute;left:50%;top:50%;width:33%;aspect-ratio:1;display:grid;place-items:center;transform:translate(-50%,-50%);border-radius:50%;background:var(--ink);color:#fff;text-align:center}
  .radial-hub-dot{grid-area:1/1;width:7px;height:7px;border-radius:50%;background:#fff}
  .radial.has-active .radial-hub-dot{opacity:0}
  .radial-hub-label{grid-area:1/1;font:700 .85rem var(--display);opacity:0}
  .radial.has-active .radial-hub-label{opacity:1}
  .radial-close{position:absolute;top:max(1rem,env(safe-area-inset-top));right:max(1rem,env(safe-area-inset-right));display:grid;place-items:center;width:40px;height:40px;border:2px solid #fff;border-radius:50%;color:#fff}
  .radial-close:hover{background:#fff;color:var(--ink)}
  .radial-legend{position:absolute;left:50%;bottom:max(1.6rem,calc(env(safe-area-inset-bottom) + 1rem));transform:translateX(-50%);color:#fff;font:500 .8rem var(--display);white-space:nowrap;opacity:.85}
  @media (max-width:480px){.radial-legend{font-size:.7rem}}
</style>

<script>
  import { UNITS, R_IN } from '../lib/radial';

  const found = document.getElementById('radial-menu');

  if (found instanceof HTMLElement) {
    const root: HTMLElement = found;
    const wheel = root.querySelector<HTMLElement>('.radial-wheel');
    const sectors = Array.from(root.querySelectorAll<SVGGElement>('.sector'));
    const labelEl = root.querySelector<HTMLElement>('[data-radial-label]');
    const trigger = document.querySelector<HTMLButtonElement>('[data-menu-trigger]');

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const STEP = 360 / sectors.length;
    const LABELS = sectors.map((sector) => sector.dataset.label ?? '');

    let isOpen = false;
    let viaKeyboard = false;
    let activeIndex = -1;
    let cx = 0;
    let cy = 0;
    let size = UNITS;
    let lastFocused: HTMLElement | null = null;

    let pressTimer = 0;
    let pressOrigin: { x: number; y: number } | null = null;

    const clamp = (value: number, min: number, max: number) =>
      Math.min(Math.max(value, min), max);

    /** O menu radial não sequestra cliques em links, campos ou texto selecionado. */
    function allowsRadial(target: EventTarget | null) {
      const el = target as HTMLElement | null;
      if (el && typeof el.closest === 'function') {
        if (
          el.closest(
            'a,button,input,textarea,select,label,[contenteditable],[data-native-menu]'
          )
        ) {
          return false;
        }
      }
      if ((window.getSelection()?.toString() ?? '').trim()) return false;
      return true;
    }

    function place(x: number, y: number) {
      const half = size / 2;
      const pad = 10;
      cx = clamp(x, half + pad, window.innerWidth - half - pad);
      cy = clamp(y, half + pad, window.innerHeight - half - pad);
      if (wheel) {
        wheel.style.setProperty('--rx', `${cx}px`);
        wheel.style.setProperty('--ry', `${cy}px`);
      }
    }

    function setActive(index: number) {
      if (index === activeIndex) return;
      activeIndex = index;
      sectors.forEach((sector, i) => sector.classList.toggle('is-active', i === index));
      if (labelEl) labelEl.textContent = index >= 0 ? LABELS[index] : '';
      root.classList.toggle('has-active', index >= 0);
    }

    function sectorFromPoint(x: number, y: number) {
      const dx = x - cx;
      const dy = y - cy;
      const distance = Math.hypot(dx, dy);
      const scale = size / UNITS;
      if (distance < R_IN * scale * 0.92) return -1;
      let angle = (Math.atan2(dy, dx) * 180) / Math.PI + 90;
      angle = ((angle % 360) + 360) % 360;
      return Math.floor((angle + STEP / 2) / STEP) % sectors.length;
    }

    function openAt(x: number, y: number, keyboard = false) {
      if (isOpen) return;
      lastFocused = document.activeElement as HTMLElement | null;

      root.hidden = false;
      size = wheel?.offsetWidth || UNITS;
      place(x, y);

      isOpen = true;
      viaKeyboard = keyboard;
      setActive(keyboard ? 0 : -1);
      root.setAttribute('aria-hidden', 'false');
      trigger?.setAttribute('aria-expanded', 'true');

      requestAnimationFrame(() => root.classList.add('is-open'));
    }

    function close(restoreFocus = false) {
      if (!isOpen) return;
      isOpen = false;
      root.classList.remove('is-open');
      root.setAttribute('aria-hidden', 'true');
      trigger?.setAttribute('aria-expanded', 'false');
      setActive(-1);

      const finish = () => {
        root.hidden = true;
      };

      if (reduce) finish();
      else window.setTimeout(finish, 300);

      if (restoreFocus) (lastFocused ?? trigger)?.focus({ preventScroll: true });
    }

    function goTo(target: string | undefined) {
      if (!target) return;
      const el = document.querySelector<HTMLElement>(target);
      if (!el) return;
      el.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
      if (window.history.replaceState) window.history.replaceState(null, '', target);
      el.setAttribute('tabindex', '-1');
      el.focus({ preventScroll: true });
    }

    function commit(index: number) {
      const target = index >= 0 ? sectors[index].dataset.target : undefined;
      close(viaKeyboard);
      window.setTimeout(() => goTo(target), reduce ? 0 : 80);
    }

    /* ---- Ponteiro ---- */

    window.addEventListener(
      'pointerdown',
      (event) => {
        if (isOpen) return;

        if (event.pointerType === 'mouse') {
          if (event.button !== 2) return;
          if (event.shiftKey) return; // escape: menu nativo do navegador
          if (!allowsRadial(event.target)) return;
          event.preventDefault();
          openAt(event.clientX, event.clientY, false);
          return;
        }

        // Toque e caneta: abre por pressão longa.
        if (!allowsRadial(event.target)) return;
        pressOrigin = { x: event.clientX, y: event.clientY };
        window.clearTimeout(pressTimer);
        pressTimer = window.setTimeout(() => {
          pressTimer = 0;
          const origin = pressOrigin;
          pressOrigin = null;
          if (origin) openAt(origin.x, origin.y, false);
        }, 420);
      },
      { passive: false }
    );

    window.addEventListener(
      'pointermove',
      (event) => {
        if (pressTimer && pressOrigin) {
          if (
            Math.hypot(event.clientX - pressOrigin.x, event.clientY - pressOrigin.y) > 10
          ) {
            window.clearTimeout(pressTimer);
            pressTimer = 0;
            pressOrigin = null;
          }
          return;
        }

        if (!isOpen) return;

        const index = sectorFromPoint(event.clientX, event.clientY);
        if (index >= 0) viaKeyboard = false;
        if (!viaKeyboard) setActive(index);
      },
      { passive: true }
    );

    window.addEventListener(
      'pointerup',
      (event) => {
        window.clearTimeout(pressTimer);
        pressTimer = 0;
        pressOrigin = null;

        if (!isOpen) return;
        if (event.pointerType === 'mouse' && event.button !== 2) return;
        commit(activeIndex);
      },
      { passive: true }
    );

    window.addEventListener(
      'pointercancel',
      () => {
        window.clearTimeout(pressTimer);
        pressTimer = 0;
        pressOrigin = null;
        if (isOpen) close(false);
      },
      { passive: true }
    );

    // Impede o menu nativo apenas onde o gesto radial é válido.
    window.addEventListener('contextmenu', (event) => {
      if (event.shiftKey) return;
      if (!allowsRadial(event.target)) return;
      event.preventDefault();
    });

    window.addEventListener('resize', () => {
      if (isOpen) close(false);
    });

    /* ---- Teclado ---- */

    window.addEventListener(
      'keydown',
      (event) => {
        const key = event.key;

        if (!isOpen) {
          if (key.toLowerCase() !== 'm') return;
          if (event.metaKey || event.ctrlKey || event.altKey) return;
          const el = event.target as HTMLElement | null;
          if (el?.closest?.('input,textarea,select,[contenteditable]')) return;
          event.preventDefault();
          openAt(window.innerWidth / 2, window.innerHeight * 0.46, true);
          return;
        }

        const handled = [
          'ArrowRight',
          'ArrowLeft',
          'ArrowUp',
          'ArrowDown',
          'Enter',
          ' ',
          'Tab',
          'Escape',
        ];

        if (handled.includes(key)) event.preventDefault();

        if (key === 'Escape') {
          close(true);
        } else if (key === 'ArrowRight' || key === 'ArrowDown') {
          viaKeyboard = true;
          setActive((activeIndex + 1 + sectors.length) % sectors.length);
        } else if (key === 'ArrowLeft' || key === 'ArrowUp') {
          viaKeyboard = true;
          setActive((activeIndex - 1 + sectors.length) % sectors.length);
        } else if (key === 'Enter' || key === ' ' || key === 'Tab') {
          commit(activeIndex);
        }
      },
      true
    );

    /* ---- Disparos explícitos ---- */

    trigger?.addEventListener('click', (event) => {
      event.preventDefault();
      if (isOpen) {
        close(true);
        return;
      }
      openAt(window.innerWidth / 2, window.innerHeight * 0.46, true);
    });

    root.querySelectorAll<HTMLElement>('[data-radial-close]').forEach((el) => {
      el.addEventListener('click', () => close(true));
    });
  }
</script>
